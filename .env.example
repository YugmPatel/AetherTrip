# AetherTrip Configuration Template
# Copy this file to .env and fill in your API keys
# DO NOT commit .env file with real keys

# ===== LLM Services =====
# Primary LLM: OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...

# Ollama fallback (local, no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== Routing =====
# OpenRouteService for travel time, distance, and route feasibility
OPENROUTESERVICE_API_KEY=

# ===== Places & Geocoding =====
# Geoapify for place search, geocoding, and POI discovery
GEOAPIFY_API_KEY=

# ===== Weather =====
# Open-Meteo (no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ===== Knowledge Enrichment =====
# Wikimedia API (no key, but User-Agent required)
WIKIMEDIA_USER_AGENT=AetherTrip/2.0 (+https://github.com/YugmPatel/AetherTrip)

# ===== Frontend =====
# Geoapify tiles for MapLibre GL JS (public key)
NEXT_PUBLIC_GEOAPIFY_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ===== Database (Future) =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Application Settings =====
CACHE_TTL_HOURS=24
MAX_REPAIR_ATTEMPTS=3
BUDGET_EMERGENCY_BUFFER_PERCENT=0.05
LOG_LEVEL=INFO
